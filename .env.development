# Left intentionally blank during development.
#
# With this file empty, src/config.js falls back to BASE_URL = '/api',
# which is proxied by Vite (see vite.config.js) to the PHP backend at
# http://localhost/inventory-management-backend/api. This sidesteps
# CORS entirely during development because the browser sees a
# same-origin request from http://localhost:5173 → /api/*.
#
# Uncomment the line below ONLY when you serve the built `dist/`
# directly from XAMPP (so the browser hits the backend at the
# absolute URL on port 80).
#
# VITE_API_BASE_URL=http://localhost/inventory-management-backend/api